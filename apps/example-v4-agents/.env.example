# Required: base URL of the Payload app (example-v4).
PAYLOAD_URL=http://localhost:3001

# Required: shared with example-v4, at least 32 characters.
# For example the output of `openssl rand -hex 32`.
FLUE_SIDECAR_SECRET=

# Required by the default model.
ANTHROPIC_API_KEY=

# Optional: a Flue model specifier. Defaults to the value below.
FLUE_MODEL=anthropic/claude-haiku-5-5
