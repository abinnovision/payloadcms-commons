# Required: signs JWTs, and the mcpx API key index derives from it. Payload
# refuses to start without it, and rotating it orphans existing MCP keys.
PAYLOAD_SECRET=change-me
DATABASE_URI=file:./.data/example.db

# Optional: absolute base URL. Its origin is also the `adminOrigin` the
# viewfinder bridge trusts. Defaults to http://localhost:3000.
PAYLOAD_URL=http://localhost:3000

# Optional: what the colophon group shows at the foot of the admin sidebar.
# Read at request time, so changing them needs a restart but not a rebuild.
# With none of them set the group does not render.
APP_VERSION=0.1.0-local
APP_COMMIT=
APP_ENVIRONMENT=development

# Optional: runs jobs through Hatchet (see compose.yaml). Without a token the
# hatchet plugin is disabled and Payload's own runner executes the jobs.
# HATCHET_CLIENT_TOKEN=
# HATCHET_CLIENT_HOST_PORT=localhost:7077
# HATCHET_CLIENT_TLS_STRATEGY=none
# Optional, with a token: runs the worker inside the Next.js server, so `yarn
# dev` alone executes the jobs. Use it or `yarn worker`, not both.
# HATCHET_IN_PROCESS_WORKER=true
