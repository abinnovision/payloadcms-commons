{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@internal/example-v3",
	"version": "0.0.0",
	"private": true,
	"description": "Example Payload CMS app mounting the payloadcms-commons packages.",
	"type": "module",
	"scripts": {
		"build": "next build",
		"dev": "NEXT_EXIT_TIMEOUT_MS=35000 NEXT_MANUAL_SIG_HANDLE=true next dev",
		"format:check": "prettier --check 'src/**/*.{ts,tsx,scss}' '*.{json{,5},md,y{,a}ml,mjs}'",
		"format:fix": "prettier --write 'src/**/*.{ts,tsx,scss}' '*.{json{,5},md,y{,a}ml,mjs}'",
		"generate:importmap": "payload generate:importmap",
		"generate:types": "payload generate:types",
		"lint:check": "eslint 'src/**/*.{ts,tsx}'",
		"lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
		"seed": "payload run src/seed.ts --",
		"start": "NEXT_MANUAL_SIG_HANDLE=true next start",
		"typecheck": "tsc --noEmit",
		"worker": "payload run src/worker.ts"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json{,5},md,y{,a}ml}": "prettier --write"
	},
	"prettier": "@abinnovision/prettier-config",
	"dependencies": {
		"@abinnovision/payloadcms-colophon": "workspace:*",
		"@abinnovision/payloadcms-dummy": "workspace:*",
		"@abinnovision/payloadcms-hatchet": "workspace:*",
		"@abinnovision/payloadcms-mcpx": "workspace:*",
		"@abinnovision/payloadcms-montage": "workspace:*",
		"@abinnovision/payloadcms-viewfinder": "workspace:*",
		"@abinnovision/payloadcms-wayfinder": "workspace:*",
		"@payloadcms/db-sqlite": "3.90.2",
		"@payloadcms/live-preview-react": "3.90.2",
		"@payloadcms/next": "3.90.2",
		"@payloadcms/richtext-lexical": "3.90.2",
		"graphql": "^17.0.2",
		"next": "^16.4.3",
		"payload": "3.90.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/prettier-config": "^2.2.0",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.13.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
