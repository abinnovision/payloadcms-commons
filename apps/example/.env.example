# Required: signs JWTs, and the mcpx API key index derives from it. Payload
# refuses to start without it, and rotating it orphans existing MCP keys.
PAYLOAD_SECRET=change-me
DATABASE_URI=file:./.data/example.db

# Optional: absolute base URL. Its origin is also the `adminOrigin` the
# viewfinder bridge trusts. Defaults to http://localhost:3000.
PAYLOAD_URL=http://localhost:3000
