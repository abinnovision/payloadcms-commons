# Required: signs JWTs. Payload refuses to start without it.
PAYLOAD_SECRET=change-me
DATABASE_URI=file:./.data/example-v4.db

# Optional: absolute base URL. Defaults to http://localhost:3001.
PAYLOAD_URL=http://localhost:3001

# Optional: what the colophon group shows at the foot of the admin sidebar.
# Read at request time, so changing them needs a restart but not a rebuild.
# With none of them set the group does not render.
APP_VERSION=0.1.0-local
APP_COMMIT=
APP_ENVIRONMENT=development

# Optional: single sign-on through the oidc plugin, off while OIDC_ISSUER is
# unset. `yarn workspace @internal/example-v4 idp` starts a local provider on
# this issuer that approves every sign-in.
# OIDC_ISSUER=http://localhost:4400
# OIDC_CLIENT_ID=payload
# OIDC_CLIENT_SECRET=local
