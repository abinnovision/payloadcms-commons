{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"dev": {
			"with": ["@internal/example-v4-agents#dev"]
		},
		"build": {
			"inputs": ["src/**/*", "next.config.mjs", "tsconfig.json"],
			"outputs": [".next/**", "!.next/cache/**"],
			"env": [
				"PAYLOAD_SECRET",
				"DATABASE_URI",
				"PAYLOAD_URL",
				"FLUE_SIDECAR_URL",
				"FLUE_SIDECAR_SECRET",
				"APP_VERSION",
				"APP_COMMIT",
				"APP_ENVIRONMENT",
				"OIDC_ISSUER",
				"OIDC_CLIENT_ID",
				"OIDC_CLIENT_SECRET"
			]
		}
	}
}
