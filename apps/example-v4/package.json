{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@internal/example-v4",
	"version": "0.0.0",
	"private": true,
	"description": "Example Payload CMS v4 app mounting the payloadcms-commons packages that support v4.",
	"type": "module",
	"scripts": {
		"build": "next build",
		"dev": "next dev -p 3001",
		"format:check": "prettier --check 'src/**/*.{ts,tsx,css}' '*.{json{,5},md,y{,a}ml,mjs}'",
		"format:fix": "prettier --write 'src/**/*.{ts,tsx,css}' '*.{json{,5},md,y{,a}ml,mjs}'",
		"generate:importmap": "NODE_OPTIONS=--preserve-symlinks payload generate:importmap",
		"generate:types": "NODE_OPTIONS=--preserve-symlinks payload generate:types",
		"lint:check": "eslint 'src/**/*.{ts,tsx}'",
		"lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
		"seed": "NODE_OPTIONS=--preserve-symlinks payload run src/seed.ts --",
		"start": "next start -p 3001",
		"typecheck": "tsc --noEmit"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json{,5},md,y{,a}ml}": "prettier --write"
	},
	"prettier": "@abinnovision/prettier-config",
	"dependencies": {
		"@abinnovision/payloadcms-colophon": "workspace:*",
		"@abinnovision/payloadcms-dummy": "workspace:*",
		"@payloadcms/db-sqlite": "4.0.0-internal.9726517",
		"@payloadcms/next": "4.0.0-internal.9726517",
		"@payloadcms/richtext-lexical": "4.0.0-internal.9726517",
		"@payloadcms/ui": "4.0.0-internal.9726517",
		"graphql": "^16.8.1",
		"next": "^16.4.2",
		"payload": "4.0.0-internal.9726517",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/prettier-config": "^2.2.0",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.12.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3"
	}
}
