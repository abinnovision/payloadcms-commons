{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@abinnovision/payloadcms-hatchet",
	"version": "0.1.0",
	"description": "Payload CMS plugin that triggers Payload jobs through Hatchet while Payload keeps running them.",
	"keywords": [
		"payload",
		"payloadcms",
		"plugin",
		"jobs",
		"queue",
		"hatchet"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abinnovision/payloadcms-commons.git",
		"directory": "packages/hatchet"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "abi group GmbH",
		"email": "info@abigroup.io",
		"url": "https://abigroup.io"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./worker": {
			"types": "./dist/worker/index.d.mts",
			"default": "./dist/worker/index.mjs"
		},
		"./next": {
			"types": "./dist/next/index.d.mts",
			"default": "./dist/next/index.mjs"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' '*.{json{,5},md,y{,a}ml}'",
		"format:fix": "prettier --write 'src/**/*.ts' 'test/**/*.ts' '*.{json{,5},md,y{,a}ml}'",
		"lint:check": "eslint 'src/**/*.ts' 'test/**/*.ts'",
		"lint:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
		"test-unit": "vitest --run --coverage --config vitest.config.mts",
		"test-unit:watch": "vitest --config vitest.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"lint-staged": {
		"{src,test}/**/*.ts": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json{,5},md,y{,a}ml}": "prettier --write"
	},
	"prettier": "@abinnovision/prettier-config",
	"dependencies": {
		"@hatchet-dev/typescript-sdk": "^1.34.0"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/prettier-config": "^2.2.0",
		"@arethetypeswrong/core": "^0.18.5",
		"@payloadcms/db-sqlite": "4.0.0-internal.9726517",
		"@swc/core": "^1.16.20",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"payload": "4.0.0-internal.9726517",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"tsdown": "^0.23.2",
		"typescript": "^6.0.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"payload": ">=3.88.0 <4"
	},
	"publishConfig": {
		"ghpr": true,
		"npm": true,
		"npmAccess": "public"
	}
}
