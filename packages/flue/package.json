{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@abinnovision/payloadcms-flue",
	"version": "0.1.0",
	"description": "Payload CMS plugin running Flue agents against the content model through mcpx: chat in the admin, runs from hooks and schedules.",
	"keywords": [
		"payload",
		"payloadcms",
		"plugin",
		"flue",
		"agents",
		"mcp"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abinnovision/payloadcms-commons.git",
		"directory": "packages/flue"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "abi group GmbH",
		"email": "info@abigroup.io",
		"url": "https://abigroup.io"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./admin": {
			"types": "./dist/admin/index.d.mts",
			"default": "./dist/admin/index.mjs"
		},
		"./agent": {
			"types": "./dist/agent/index.d.mts",
			"default": "./dist/agent/index.mjs"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"format:check": "prettier --check 'src/**/*.{ts,tsx}' 'test/**/*.ts' '*.{json{,5},md,y{,a}ml}'",
		"format:fix": "prettier --write 'src/**/*.{ts,tsx}' 'test/**/*.ts' '*.{json{,5},md,y{,a}ml}'",
		"lint:check": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.ts'",
		"lint:fix": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.ts' --fix",
		"test-integration": "vitest --run --config test/integration/vitest.config.mts",
		"test-unit": "vitest --run --coverage --config vitest.config.mts",
		"test-unit:watch": "vitest --config vitest.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"lint-staged": {
		"{src,test}/**/*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json{,5},md,y{,a}ml}": "prettier --write"
	},
	"prettier": "@abinnovision/prettier-config",
	"dependencies": {
		"@assistant-ui/react": "0.15.32",
		"@assistant-ui/react-markdown": "0.14.24",
		"@flue/sdk": "2.3.0",
		"eventsource-parser": "^4.1.3"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/payloadcms-mcpx": "workspace:*",
		"@abinnovision/prettier-config": "^2.2.0",
		"@arethetypeswrong/core": "^0.18.5",
		"@flue/runtime": "2.3.0",
		"@internal/test-utils": "workspace:*",
		"@payloadcms/db-sqlite": "4.0.0-beta.7",
		"@payloadcms/ui": "4.0.0-beta.7",
		"@swc/core": "^1.16.22",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.14.0",
		"happy-dom": "21.0.4",
		"payload": "4.0.0-beta.7",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsdown": "^0.23.5",
		"typescript": "^6.0.3",
		"unplugin-swc": "^2.0.0",
		"valibot": "^1.1.0",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"@abinnovision/payloadcms-mcpx": ">=2.1.0 <3",
		"@flue/runtime": "^2.3.0",
		"@payloadcms/ui": ">=4.0.0-beta.7 <5",
		"payload": ">=4.0.0-beta.7 <5",
		"react": "^19",
		"valibot": "^1.1.0"
	},
	"peerDependenciesMeta": {
		"@abinnovision/payloadcms-mcpx": {
			"optional": true
		},
		"@flue/runtime": {
			"optional": true
		},
		"@payloadcms/ui": {
			"optional": true
		},
		"payload": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"valibot": {
			"optional": true
		}
	},
	"publishConfig": {
		"ghpr": true,
		"npm": true,
		"npmAccess": "public"
	}
}
