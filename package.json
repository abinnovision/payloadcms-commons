{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@internal/payloadcms-commons",
	"private": true,
	"author": {
		"name": "abi group GmbH",
		"email": "info@abigroup.io",
		"url": "https://abigroup.io"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"build:watch": "turbo watch build",
		"check": "yarn format:check && yarn sort:check && turbo run check",
		"clean": "rimraf -g -I 'coverage/' 'packages/*/{coverage,dist,.turbo}'",
		"fix": "yarn format:fix && yarn sort:fix && turbo run fix",
		"format:check": "prettier --ignore-path .gitignore --check '{.github/**/*,*}.{json{,5},md,y{,a}ml,{c,m,}{j,t}s}'",
		"format:fix": "prettier --ignore-path .gitignore --write '{.github/**/*,*}.{json{,5},md,y{,a}ml,{c,m,}{j,t}s}'",
		"postinstall": "husky",
		"lint:check": "eslint '*.{m,c,}{j,t}s'",
		"lint:fix": "eslint '*.{m,c,}{j,t}s' --fix",
		"sort:check": "sort-package-json 'packages/**!(node_modules)/package.json' 'package.json' --check",
		"sort:fix": "sort-package-json 'packages/**!(node_modules)/package.json' 'package.json'",
		"test": "vitest run --coverage --passWithNoTests",
		"test-unit": "vitest run --project '*#unit' --coverage --passWithNoTests"
	},
	"commitlint": {
		"extends": [
			"@abinnovision/commitlint-config"
		]
	},
	"lint-staged": {
		"**/package.json": "sort-package-json",
		"{.github/**/*,*}.{json{,5},md,y{,a}ml}": "prettier --write"
	},
	"prettier": "@abinnovision/prettier-config",
	"devDependencies": {
		"@abinnovision/commitlint-config": "^2.3.1",
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/prettier-config": "^2.2.0",
		"@commitlint/cli": "^21.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.7.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"prettier": "^3.9.5",
		"rimraf": "^6.1.3",
		"sort-package-json": "^4.0.0",
		"turbo": "^2.10.5",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"packageManager": "yarn@4.18.0"
}
